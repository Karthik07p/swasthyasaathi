# Server Environment Variables
# Copy this file to .env and fill in real values

# MongoDB Atlas connection string
# Get from: cloud.mongodb.com → your cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/swasthyasaathi?retryWrites=true&w=majority

# Google Gemini API key (free tier)
# Get from: aistudio.google.com → Get API key
GEMINI_API_KEY=AIzaSy...

# Optional: override the Gemini model (default: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash
# Comma-separated models tried in order if the primary is overloaded
# GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite

PORT=3001
